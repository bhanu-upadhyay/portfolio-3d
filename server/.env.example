# Server Port
PORT=5001

# Environment (development, production, test)
NODE_ENV=development

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Replace with your local or MongoDB Atlas URI)
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/nexus_portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/nexus_portfolio

# Rate Limiting Window in Minutes
RATE_LIMIT_WINDOW_MS=900000

# Rate Limiting Max Requests per Window
RATE_LIMIT_MAX=100
